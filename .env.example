# Copia este archivo como ".env" y ajusta la URL según el dispositivo:
# - Web/Chrome:        http://localhost:3000/api
# - Emulador Android:  http://10.0.2.2:3000/api
# - Dispositivo físico: http://<TU_IP_LOCAL>:3000/api
#
# Obtén tu IP local con "hostname -I" (Linux) o "ipconfig" (Windows).
# La URL se compila dentro del APK: si cambia la IP, hay que recompilar.
API_URL=http://localhost:3000/api
